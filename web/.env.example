# LiveKit Cloud project credentials (dashboard -> Settings -> API keys).
# Use the SAME project the agent is deployed to.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Must match agent_name in agent/agent.py (explicit dispatch).
AGENT_NAME=line-qa-agent

# Required in production for a public demo link (see app/api/token/route.ts).
ALLOW_PUBLIC_TOKENS=true

# Shown on the landing page.
NEXT_PUBLIC_AUTHOR_NAME=Arun Nayagam
NEXT_PUBLIC_REPO_URL=https://github.com/your-username/line-qa-voice-agent
NEXT_PUBLIC_SESSION_LIMIT_SECONDS=180
